{
  "manifest_version": 3,
  "name": "nForce Tools",
  "version": "4.3.0",
  "description": "NForce Tools：支持订单查询、报表获取、批量数据处理、智能数据分析及 Bulk API 2.0 操作，包含 Tools 工具模块（中午食乜抽签、批量操作）",
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "nForce Tools（点击开关侧边栏）"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "cookies",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.force.com/*",
    "https://*.cloudforce.com/*",
    "https://*.visualforce.com/*",
    "https://*.sfcrmapps.cn/*",
    "https://*.sfcrmproducts.cn/*",
    "https://*.salesforce.mil/*",
    "https://*.force.mil/*",
    "https://*.cloudforce.mil/*",
    "https://*.visualforce.mil/*",
    "https://*.crmforce.mil/*",
    "https://*.force.com.mcas.ms/*",
    "https://*.builder.salesforce-experience.com/*",
    "https://graph.microsoft.com/v1.0/*"
  ],
  "commands": {
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "打开 / 隐藏 nForce Tools 侧边栏"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.visualforce.com/*",
        "https://*.force.com.mcas.ms/*"
      ],
      "js": [
        "dock.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.salesforce.com https://*.force.com https://*.salesforce-setup.com https://*.cloudforce.com https://*.visualforce.com https://*.sfcrmapps.cn https://*.sfcrmproducts.cn https://*.salesforce.mil https://*.force.mil https://*.cloudforce.mil https://*.visualforce.mil https://*.crmforce.mil https://*.force.com.mcas.ms https://*.builder.salesforce-experience.com https://graph.microsoft.com https://*.sharepoint.com https://*.onedrive.microsoft.com;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "login.html",
        "lib/css/*",
        "lib/js/*",
        "lib/js/dayjs.min.js",
        "lib/js/jszip.min.js",
        "lib/js/marked.min.js",
        "lib/js/xlsx.full.min.js",
        "lib/css/antd.min.css",
        "lib/css/main.css",
        "icons/*",
        "docs/README.md",
        "docs/LTS_Fallout_Summary.md",
        "rules/ui_layout.json"
      ],
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.visualforce.com/*",
        "https://*.force.com.mcas.ms/*"
      ]
    }
  ]
}
