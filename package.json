{
  "name": "nforce-tools",
  "version": "4.2.1",
  "description": "NForce Tools: Chrome扩展用于Salesforce订单查询、报表获取、数据分析等",
  "main": "src/app.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "purge:css": "node tools/purge-antd-css.mjs",
    "build": "npm run purge:css && webpack --mode production",
    "build:dev": "npm run purge:css && webpack --mode development",
    "watch": "webpack --watch --mode development",
    "clean": "rimraf dist",
    "check:ui": "node tools/check-ui.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "chrome-extension",
    "salesforce",
    "tools"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.4",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  },
  "dependencies": {
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "jszip": "^3.10.1",
    "marked": "^12.0.1",
    "xlsx": "^0.18.5"
  }
}
