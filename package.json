{
  "name": "nforce-tools",
  "version": "4.12.2",
  "description": "NForce Tools: Chrome扩展用于Salesforce订单查询、报表获取、数据分析等",
  "main": "src/app.js",
  "scripts": {
    "purge:css": "node tools/purge-antd-css.mjs",
    "build": "npm run purge:css && vite build",
    "build:dev": "npm run purge:css && vite build --mode development",
    "dev": "vite build --watch",
    "watch": "vite build --watch",
    "clean": "rimraf dist",
    "check:ui": "node tools/check-ui.mjs",
    "check:coverage": "node tools/check-test-coverage.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "chrome-extension",
    "salesforce",
    "tools"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "rimraf": "^5.0.5",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "jszip": "^3.10.1",
    "marked": "^12.0.1",
    "xlsx": "^0.18.5"
  }
}
